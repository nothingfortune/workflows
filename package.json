{
  "name": "@nothingfortune/workflows",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "integrity": "engine/dist/bin/integrity.mjs" },
  "files": ["engine/dist"],
  "scripts": {
    "test": "node --test 'scripts/*.test.mts' 'engine/test/**/*.test.mts'",
    "audit": "node scripts/audit-selftest.mts && node scripts/audit-workflows.mts .github/workflows",
    "build": "tsc -p engine",
    "build:check": "npm run build && git diff --exit-code -- engine/dist",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test && npm run audit && npm run build:check"
  },
  "peerDependencies": { "knip": ">=6 <7" },
  "devDependencies": { "@types/node": "^24", "knip": "6.41.0", "typescript": "6.0.3" }
}
